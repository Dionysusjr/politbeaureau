# =======================================================================
# Capitol Ledger — US political trading disclosures
# =======================================================================

# --- Trade data source -------------------------------------------------
# One of: auto | simulated | live
#   auto      - try every configured live source, fall back to the simulator
#               if none returns transaction-level data. (Default in dev.)
#   simulated - built-in simulator only. Zero setup. Uses FICTIONAL filers
#               (never real officials' names) and is labelled "SIMULATED"
#               throughout the UI.
#   live      - STRICT: live sources only, the simulator NEVER runs, so no
#               placeholder data can appear. An empty result renders as an
#               honest "awaiting live data" state. (Default in production,
#               i.e. on any deployed site.)
# Leave unset to get the defaults: auto in dev, live in production.
CONGRESS_DATA_SOURCE=

# How often the browser polls the dashboard, in milliseconds.
NEXT_PUBLIC_CONGRESS_POLL_MS=30000

# How often the SERVER refreshes from upstream, in milliseconds. Kept much
# longer than the browser poll on purpose: government endpoints are slow and
# rate-limited, and aggregators bill per request. Browser polls are served
# from an in-process cache between refreshes.
# Defaults: 300000 (live) / 10000 (simulated).
SNAPSHOT_TTL_MS=

# Identifies your requests to upstream sources. SEC's fair-access policy
# REQUIRES a contact address in the User-Agent; House/Senate behave better
# with one. Set this before enabling any live source.
CONTACT_EMAIL=

# --- Free primary sources (no key needed; set to "false" to disable) ---
# House Clerk PTR index: disclosures-clerk.house.gov <YEAR>FD.zip
#   NOTE: this index is FILING-LEVEL ONLY. Ticker/amount/buy-sell detail
#   lives inside each PTR PDF (many are scans needing OCR), so this source
#   populates the filings feed and roster, never ticker-level trades. Use an
#   aggregator below for real House transaction data.
ENABLE_HOUSE_CLERK=true
# Senate eFD: efd.senate.gov. Electronic PTRs expose an HTML transactions
# table, so this DOES yield ticker-level trades. Rides on an undocumented
# internal endpoint behind a CSRF/cookie handshake — best-effort.
ENABLE_SENATE_EFD=true
# SEC EDGAR Form 4 corporate-insider filings, shown as context on asset
# pages (a separate disclosure regime, never merged into filer totals).
ENABLE_SEC_FORM4=true

# --- Commercial aggregators (each enabled by its key being present) ----
# These do the PDF extraction the primary sources don't, so they are the
# practical route to ticker-level House data.
QUIVER_API_KEY=
UNUSUAL_WHALES_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
CONGRESSINVESTS_API_KEY=
LAMBDA_API_KEY=

# Optional endpoint overrides — these are commercial APIs whose routes and
# plan gating change; repoint them here instead of waiting on a code change.
QUIVER_CONGRESS_URL=
UNUSUAL_WHALES_CONGRESS_URL=
FMP_SENATE_URL=
FMP_HOUSE_URL=
FINNHUB_CONGRESS_URL=
CONGRESSINVESTS_URL=
LAMBDA_CONGRESS_URL=

# --- Price history for the asset-level view ----------------------------
# One of: synthetic | stooq | yahoo
#   synthetic - deterministic simulated series, zero setup, labelled
#               "SIMULATED PRICE" in the UI. (Default in dev.)
#   stooq     - free daily CSV, no key or registration. (Default in
#               production, so a published page shows real prices.)
#   yahoo     - Yahoo Finance chart JSON; no key but undocumented/unstable.
# In auto/simulated congress modes a failed fetch falls back to the labelled
# synthetic series; in strict live mode it shows NO price data instead —
# a published live page never shows placeholder prices.
# Leave unset to get the defaults: synthetic in dev, stooq in production.
PRICE_DATA_SOURCE=